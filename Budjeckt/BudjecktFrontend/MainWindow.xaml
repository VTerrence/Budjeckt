<Window x:Class="BudjecktFrontend.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BudjecktFrontend"
        mc:Ignorable="d"
        Title="Budjeckt — Suivi de dépenses"
        Height="640" Width="1000"
        MinHeight="640" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barre de navigation des mois -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <Border Padding="8" Background="#1565C0" CornerRadius="6">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="‹"
                            Command="{Binding PrecedentMoisCommand}"
                            AutomationProperties.Name="Mois précédent"
                            Width="34" Height="30" FontSize="18"
                            ToolTip="Mois précédent"/>
                    <ComboBox ItemsSource="{Binding NomsMois}"
                              SelectedIndex="{Binding IndexMoisSelectionne, UpdateSourceTrigger=PropertyChanged}"
                              Width="150" Margin="8,0" Height="30"
                              FontSize="14"/>
                    <Button Content="›"
                            Command="{Binding SuivantMoisCommand}"
                            AutomationProperties.Name="Mois suivant"
                            Width="34" Height="30" FontSize="18"
                            ToolTip="Mois suivant"/>
                    <ComboBox ItemsSource="{Binding Annees}"
                              SelectedIndex="{Binding IndexAnneeSelectionnee, UpdateSourceTrigger=PropertyChanged}"
                              Width="92" Margin="10,0,0,0" Height="30"
                              FontSize="14"
                              ToolTip="Choisir une année"/>
                    <Button Content="＋"
                            Command="{Binding CreerAnneeSuivanteCommand}"
                            AutomationProperties.Name="Créer l'année suivante"
                            Width="32" Height="30" Margin="4,0,0,0" FontSize="16"
                            ToolTip="Créer l'année suivante"/>
                    <Button Content="Supprimer…"
                            Command="{Binding OuvrirPanneauSuppressionCommand}"
                            AutomationProperties.Name="Supprimer des années"
                            Width="90" Height="30" Margin="4,0,0,0" FontSize="13"
                            ToolTip="Supprimer une ou plusieurs années"/>
                    <TextBlock Text="{Binding NomAnnee}"
                               Foreground="White" FontSize="16" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="14,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- Panneau de suppression d'années (multi-sélection + confirmation) -->
            <Border Padding="10" Background="#FFF3E0" CornerRadius="6" Margin="0,10,0,0"
                    BorderBrush="#F57C00" BorderThickness="1"
                    Visibility="{Binding PanneauSuppressionVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Années à supprimer (cocher une ou plusieurs années) :"
                               FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding AnneesSuppression}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Libelle}"
                                              IsChecked="{Binding EstCochee}"
                                              Margin="4,2" MinWidth="110"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                        <Button Content="Tout sélectionner"
                                Command="{Binding ToutSelectionnerAnneesCommand}"
                                AutomationProperties.Name="Tout sélectionner"
                                Height="30" Margin="0,0,6,0" Padding="10,0"/>
                        <Button Content="Tout désélectionner"
                                Command="{Binding ToutDeselectionnerAnneesCommand}"
                                AutomationProperties.Name="Tout désélectionner"
                                Height="30" Margin="0,0,10,0" Padding="10,0"/>
                        <Button Content="Supprimer"
                                Command="{Binding SupprimerAnneesCommand}"
                                AutomationProperties.Name="Confirmer la suppression des années"
                                Background="#C62828" Foreground="White" Height="30"
                                Margin="0,0,8,0" Padding="12,0"/>
                        <Button Content="Annuler"
                                Command="{Binding AnnulerSuppressionCommand}"
                                AutomationProperties.Name="Annuler la suppression des années"
                                Height="30" Padding="12,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Zone principale : saisie / budget à gauche, historique à droite -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Zone de saisie + budget -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
                <StackPanel>
                    <GroupBox Header="Nouvelle dépense" Padding="10">
                        <GroupBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding AjouterFactureCommand}"/>
                        </GroupBox.InputBindings>
                        <StackPanel>
                            <TextBlock Text="Montant" Margin="0,0,0,3"/>
                            <TextBox Text="{Binding MontantSaisi, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Valeur numérique strictement positive (ex. 12,50)"/>
                            <TextBlock Text="Catégorie" Margin="0,10,0,3"/>
                            <ComboBox ItemsSource="{Binding CategoriesAjout}"
                                      SelectedIndex="{Binding IndexCategorieAjout}"
                                      IsEnabled="{Binding CategoriesDisponibles}"/>
                            <TextBlock Text="Date" Margin="0,10,0,3"/>
                            <DatePicker SelectedDate="{Binding DateSaisie}"
                                        DisplayDateStart="{Binding DateMin}"
                                        DisplayDateEnd="{Binding DateMax}"
                                        SelectedDateFormat="Short"/>
                            <TextBlock Text="Heure (optionnelle, HH:mm)" Margin="0,10,0,3"/>
                            <TextBox Text="{Binding HeureSaisie, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Format HH:mm, ex. 14:30. Laisser vide si aucune heure."/>
                            <TextBlock Text="{Binding MessageErreur}"
                                       Foreground="#C62828" TextWrapping="Wrap"
                                       MinHeight="32" Margin="0,8,0,0"/>
                            <Button Content="Ajouter la dépense"
                                    Command="{Binding AjouterFactureCommand}"
                                    Height="34" FontSize="14" FontWeight="SemiBold"
                                    Background="#2E7D32" Foreground="White" Padding="10,0"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Budget du mois" Padding="10" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Revenue (budget)" Margin="0,0,0,3"/>
                            <TextBox Text="{Binding RevenueSaisi, UpdateSourceTrigger=LostFocus}"/>
                            <Button Content="Enregistrer le budget"
                                    Command="{Binding EnregistrerBudgetCommand}"
                                    Margin="0,8,0,0" Height="30"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Total dépenses : " Foreground="#424242"/>
                                <TextBlock Text="{Binding TotalMoisTexte}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="Reste : " Foreground="#424242"/>
                                <TextBlock Text="{Binding ResteTexte}" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RestePositif}" Value="False">
                                                    <Setter Property="Foreground" Value="#C62828"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Catégories" Padding="10" Margin="0,10,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Text="{Binding NouvelleCategorieSaisie, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Nouvelle catégorie"
                                         ToolTip="Nom de la catégorie à ajouter pour toute l'année"
                                         MaxLength="100"
                                         MinWidth="150"/>
                                <Button Content="+ Ajouter"
                                        Command="{Binding AjouterCategorieCommand}"
                                        AutomationProperties.Name="Ajouter une catégorie"
                                        Margin="6,0,0,0" Height="26" Padding="10,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <ComboBox ItemsSource="{Binding CategoriesSuppression}"
                                          SelectedIndex="{Binding IndexCategorieSuppression}"
                                          AutomationProperties.Name="Catégorie à supprimer"
                                          IsEnabled="{Binding CategoriesDisponibles}"
                                          ToolTip="Catégorie à supprimer pour toute l'année, avec ses factures"
                                          MinWidth="150"/>
                                <Button Content="Supprimer"
                                        Command="{Binding SupprimerCategorieCommand}"
                                        AutomationProperties.Name="Supprimer une catégorie"
                                        Margin="6,0,0,0" Height="26" Padding="10,0"
                                        Background="#C62828" Foreground="White"/>
                            </StackPanel>
                            <TextBlock Text="{Binding MessageSucces}"
                                       Foreground="#2E7D32" TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <!-- Zone d'affichage de l'historique -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                    <TextBlock Text="Filtre : " VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding CategoriesFiltre}"
                              SelectedIndex="{Binding IndexCategorieFiltre}"
                              Width="240"
                              ToolTip="Afficher uniquement les dépenses d'une catégorie"/>
                </StackPanel>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding FacturesAffichees}"
                          local:DataGridSelectionBehavior.SelectedItems="{Binding FacturesSelectionnees}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          CanUserSortColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Extended"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderBrush="#BDBDBD" BorderThickness="1">
                    <DataGrid.InputBindings>
                        <KeyBinding Key="Delete" Command="{Binding SupprimerFactureCommand}"/>
                    </DataGrid.InputBindings>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <!-- La ligne « Total » est mise en évidence et rendue non sélectionnable. -->
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EstTotal}" Value="True">
                                    <Setter Property="Background" Value="#ECEFF1"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding DateTexte}" Width="130"/>
                        <DataGridTextColumn Header="Heure" Binding="{Binding HeureTexte}" Width="70"/>
                        <DataGridTextColumn Header="Catégorie" Binding="{Binding NomCategorie}" Width="*"/>
                        <DataGridTextColumn Header="Montant" Binding="{Binding MontantTexte}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="6,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Button Grid.Row="2"
                        Content="Supprimer la sélection"
                        Command="{Binding SupprimerFactureCommand}"
                        HorizontalAlignment="Right"
                        Margin="0,8,0,0" Height="30"
                        Background="#C62828" Foreground="White" Padding="12,0"/>
            </Grid>
        </Grid>

        <!-- Zone de synthèse -->
        <Border Grid.Row="2" Margin="0,10,0,0" Padding="12" Background="#ECEFF1" CornerRadius="6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Total du mois : " FontWeight="SemiBold" Margin="0,0,4,0"/>
                <TextBlock Text="{Binding TotalMoisTexte}" FontWeight="SemiBold" Margin="0,0,24,0"/>
                <TextBlock Text="Reste du budget : " FontWeight="SemiBold" Margin="0,0,4,0"/>
                <TextBlock Text="{Binding ResteTexte}" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>